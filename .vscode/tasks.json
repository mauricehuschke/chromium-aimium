{
  "version": "2.0.0",
  "options": {"cwd": "${workspaceFolder}"},
  "presentation": {"reveal": "always", "panel": "dedicated", "focus": false},
  "windows": {
    "options": {
      "cwd": "${workspaceFolder}",
      "shell": {"executable": "${env:ComSpec}", "args": ["/d", "/v:off", "/c"]}
    }
  },
  "tasks": [
    {
      "label": "Aimium: Build + Smoke (lokal)",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/aimium/tools/build.py", "build", "--target", "linux-x64", "--browser-tests", "--jobs", "${input:aimiumJobs}"],
      "windows": {
        "command": "call",
        "args": ["${workspaceFolder}\\aimium\\tools\\python.cmd", "${workspaceFolder}\\aimium\\tools\\build.py", "build", "--target", "win-x64", "--browser-tests", "--jobs", "${input:aimiumJobs}", "--out-dir", "out/Aimium/win-x64-ninja"]
      },
      "osx": {
        "args": ["${workspaceFolder}/aimium/tools/build.py", "build", "--target", "${input:aimiumMacTarget}", "--browser-tests", "--jobs", "${input:aimiumJobs}"]
      },
      "group": {"kind": "build", "isDefault": true},
      "runOptions": {"instanceLimit": 1},
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "Aimium: Voraussetzungen prüfen",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/aimium/tools/build.py", "check", "--target", "linux-x64", "--browser-tests"],
      "windows": {
        "command": "call",
        "args": ["${workspaceFolder}\\aimium\\tools\\python.cmd", "${workspaceFolder}\\aimium\\tools\\build.py", "check", "--target", "win-x64", "--browser-tests", "--out-dir", "out/Aimium/win-x64-ninja"]
      },
      "osx": {
        "args": ["${workspaceFolder}/aimium/tools/build.py", "check", "--target", "${input:aimiumMacTarget}", "--browser-tests"]
      },
      "problemMatcher": []
    },
    {
      "label": "Aimium: Buildplan prüfen",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/aimium/tools/build.py", "build", "--target", "linux-x64", "--browser-tests", "--jobs", "${input:aimiumJobs}", "--dry-run"],
      "windows": {
        "command": "call",
        "args": ["${workspaceFolder}\\aimium\\tools\\python.cmd", "${workspaceFolder}\\aimium\\tools\\build.py", "build", "--target", "win-x64", "--browser-tests", "--jobs", "${input:aimiumJobs}", "--out-dir", "out/Aimium/win-x64-ninja", "--dry-run"]
      },
      "osx": {
        "args": ["${workspaceFolder}/aimium/tools/build.py", "build", "--target", "${input:aimiumMacTarget}", "--browser-tests", "--jobs", "${input:aimiumJobs}", "--dry-run"]
      },
      "problemMatcher": []
    },
    {
      "label": "Aimium: Python-Tests (lokal)",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "unittest", "discover", "-s", "aimium/tests", "-v"],
      "windows": {
        "command": "call",
        "args": ["${workspaceFolder}\\aimium\\tools\\python.cmd", "-m", "unittest", "discover", "-s", "aimium/tests", "-v"]
      },
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Aimium: Vertragsbeispiele (lokal)",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/aimium/contracts/validate.py", "--examples"],
      "windows": {
        "command": "call",
        "args": ["${workspaceFolder}\\aimium\\tools\\python.cmd", "${workspaceFolder}\\aimium\\contracts\\validate.py", "--examples"]
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "aimiumJobs",
      "type": "pickString",
      "description": "Parallele Compileraufträge; gleicher Ausgabeordner und Ninja-Cache bleiben erhalten.",
      "options": ["4", "8", "2", "1", "12", "16"],
      "default": "4"
    },
    {
      "id": "aimiumMacTarget",
      "type": "pickString",
      "description": "Native Architektur dieses Macs (keine Cross-Plattform-Abnahme).",
      "options": [{"label": "Apple Silicon", "value": "mac-arm64"}, {"label": "Intel", "value": "mac-x64"}],
      "default": "mac-arm64"
    }
  ]
}
